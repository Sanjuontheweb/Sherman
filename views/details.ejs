<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>

    <style>
        :root {
            --font-display: "Anton", "Arial Narrow", sans-serif;
            --font-body: "Inter", Arial, sans-serif;
            --font-serif: "Fraunces", Georgia, serif;
        }

        :root {
            --bg: #f7e7ce;
            --surface: #fffaf1;
            --header-bg: #f7e7ce;
            --ink: #1c1210;
            --muted: #6b5c50;
            --line: #1c1210;

            --accent: #c8432e;
            --on-accent: #f7e7ce;
            --icon-filter: brightness(0);

            /* Product cards read as a fixed dark, editorial surface in
                both themes, so they hold their contrast either way. */
            --card-bg-cards: #1c1210;
            --card-bg: #1c1210;
            --card-ink: #f3e9db;
            --card-muted: #b6a99a;
            --card-line: #3a2c26;
            }

        @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
            --bg: #180307;
            --surface: #22060c;
            --header-bg: #180307;
            --ink: #f3e6d8;
            --muted: #b79c8c;
            --line: #f3e6d8;

            --accent: #ff7a5c;
            --on-accent: #180307;
            --icon-filter: brightness(0) invert(1);

            --card-bg-cards: #f3cea6;
            --card-bg: #f3e6d8;
            --card-ink: #1c1210;
            --card-muted: #6b5c50;
            --card-line: #d9c8b5;
        }
            }

        :root[data-theme="dark"] {
            --bg: #180307;
            --surface: #22060c;
            --header-bg: #180307;
            --ink: #f3e6d8;
            --muted: #b79c8c;
            --line: #f3e6d8;

            --accent: #ff7a5c;
            --on-accent: #180307;
            --icon-filter: brightness(0) invert(1);

            --card-bg-cards: #f3cea6;
            --card-bg: #f3e6d8;
            --card-ink: #1c1210;
            --card-muted: #6b5c50;
            --card-line: #d9c8b5;
        }

        body {
            background-color:  var(--bg);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .text {
            font-family: var(--font-display);
            font-size: 7rem;
            color: var(--ink);
        }

        .sub {
            font-family: var(--font-display);
            font-size: 3rem;
            color: var(--ink);
        }
    </style>
</head>
<body>
    <div class="text">
        <p class="sub">Welcome, Please enter the product ID</p>
    </div>
</body>
</html>